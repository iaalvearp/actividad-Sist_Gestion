---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageIntro from "@/components/PageIntro.astro";
import CallToAction from "@/components/CallToAction.astro";
---

<BaseLayout title="Página no encontrada">
  <div>
    <PageIntro eyebrow="404" title="No encontramos esta página." description="Es posible que la dirección haya cambiado. Puedes volver al inicio o contarnos qué estabas buscando." />
    <CallToAction title="¿Hablamos de lo que tu equipo necesita?" description="Cuéntanos cómo trabajan hoy y exploremos juntos si la IA puede aportar valor." />
  </div>
</BaseLayout>
