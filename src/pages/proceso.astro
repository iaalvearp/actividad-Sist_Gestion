---
import { ArrowDown, Check } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { processSteps } from "@/data/process";
import CallToAction from "@/components/CallToAction.astro";
import PageIntro from "@/components/PageIntro.astro";
---

<BaseLayout
  title="Nuestro proceso de implementación de IA"
  description="Cuatro etapas para diagnosticar, priorizar, probar y medir una solución de inteligencia artificial junto a tu equipo."
>
  <div>
    <PageIntro eyebrow="Nuestro proceso" title="Un camino claro, construido en equipo." description="Cada proyecto parte de escuchar y entender. De ahí, avanzamos con objetivos compartidos y decisiones que tu organización puede revisar." />
    <section class="section-block process-page-section">
      <div class="container">
        <div class="process-timeline">
          {
            processSteps.map((step, index) => (
              <article class="timeline-step">
                <div class="timeline-marker"><span>{step.number}</span>{index < processSteps.length - 1 && <span class="timeline-line" aria-hidden="true"></span>}</div>
                <div class="timeline-content">
                  <span class="timeline-label">Etapa {step.number}</span>
                  <h2>{step.title}</h2>
                  <p>{step.description}</p>
                  <div class="timeline-outcome"><Check size={17} aria-hidden="true" /><span><strong>Al cerrar esta etapa</strong>{step.outcome}</span></div>
                </div>
                <span class="timeline-arrow" aria-hidden="true">{index < processSteps.length - 1 ? <ArrowDown size={19} /> : null}</span>
              </article>
            ))
          }
        </div>
        <div class="process-note"><span class="process-note-mark">i</span><p>El alcance y el orden pueden adaptarse a tu contexto. Si un piloto no aporta valor, revisamos juntos qué aprendimos antes de seguir.</p></div>
      </div>
    </section>
    <CallToAction title="El primer paso es entender el reto." description="Cuéntanos qué proceso te gustaría mejorar y te ayudaremos a explorar opciones realistas." />
  </div>
</BaseLayout>
