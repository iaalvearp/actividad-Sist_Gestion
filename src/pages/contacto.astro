---
import { Mail, MapPin, Phone, Clock3, ArrowUpRight } from "@lucide/astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ContactForm from "@/components/ContactForm.astro";
import PageIntro from "@/components/PageIntro.astro";
import { faqs } from "@/data/faq";
import { contactDetails } from "@/data/site";
---

<BaseLayout
  title="Contacto y diagnóstico inicial"
  description="Conversemos sobre los procesos de tu pyme y exploremos si una iniciativa de inteligencia artificial puede aportar valor."
>
  <div>
    <PageIntro eyebrow="Contacto" title="Empecemos con una conversación." description="Cuéntanos qué te gustaría mejorar. Revisaremos el contexto contigo y hablaremos de posibles primeros pasos, sin compromiso." />
    <section class="section-block contact-main-section">
      <div class="container contact-grid">
        <div class="contact-form-panel">
          <div class="contact-panel-heading"><span class="eyebrow">Cuéntanos tu idea</span><h2>¿Qué está pasando en tu empresa?</h2><p>Completa los campos y verás una confirmación de demostración en esta página.</p></div>
          <ContactForm />
        </div>
        <aside class="contact-aside">
          <div class="contact-aside-top"><span class="contact-aside-icon"><ArrowUpRight size={19} aria-hidden="true" /></span><span class="eyebrow eyebrow-light">Estamos en Guayaquil</span><h2>Un buen proyecto empieza escuchando.</h2><p>Conversemos sobre tus objetivos, tu equipo y los procesos que quisieras hacer más simples.</p></div>
          <div class="contact-detail-list">
            <a href={`mailto:${contactDetails.email}`}><Mail size={17} aria-hidden="true" /><span><small>Correo</small>{contactDetails.email}</span></a>
            <a href={`tel:${contactDetails.phone.replaceAll(" ", "")}`}><Phone size={17} aria-hidden="true" /><span><small>Teléfono</small>{contactDetails.phone}</span></a>
            <div><MapPin size={17} aria-hidden="true" /><span><small>Ubicación</small>{contactDetails.location}</span></div>
            <div><Clock3 size={17} aria-hidden="true" /><span><small>Horario de atención</small>{contactDetails.hours}</span></div>
          </div>
          <p class="contact-fictional-note">{contactDetails.note}</p>
        </aside>
      </div>
    </section>
    <section class="section-block faq-section" aria-labelledby="faq-heading">
      <div class="container faq-grid">
        <div class="faq-intro"><span class="eyebrow">Preguntas frecuentes</span><h2 id="faq-heading">Lo que quizá te preguntas.</h2><p>Si necesitas más contexto, podemos conversar sobre tu caso particular.</p></div>
        <div class="faq-list">
          {faqs.map((faq, index) => <details class="faq-item" open={index === 0}><summary><span>{faq.question}</span><span class="faq-plus" aria-hidden="true"></span></summary><p>{faq.answer}</p></details>)}
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
