---
interface Props {
  eyebrow: string;
  title: string;
  description: string;
}

const { eyebrow, title, description } = Astro.props;
---

<section class="page-intro">
  <div class="container page-intro-inner">
    <span class="eyebrow"><span class="eyebrow-dot"></span>{eyebrow}</span>
    <h1>{title}</h1>
    <p>{description}</p>
  </div>
</section>
