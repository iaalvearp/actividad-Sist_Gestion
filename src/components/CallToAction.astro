---
import { ArrowUpRight, Sparkles } from "@lucide/astro";

interface Props {
  title: string;
  description: string;
  buttonLabel?: string;
}

const { title, description, buttonLabel = "Agenda un diagnóstico" } = Astro.props;
---

<section class="cta-section">
  <div class="container cta-panel">
    <span class="cta-spark" aria-hidden="true"><Sparkles size={23} stroke-width={1.5} /></span>
    <div class="cta-copy"><span class="eyebrow eyebrow-light">Una conversación puede ser el primer paso</span><h2>{title}</h2><p>{description}</p></div>
    <a class="button button-light" href="/contacto">{buttonLabel}<ArrowUpRight size={17} aria-hidden="true" /></a>
    <span class="cta-decoration" aria-hidden="true"><span></span><span></span><span></span></span>
  </div>
</section>
