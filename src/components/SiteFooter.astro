---
import { ArrowUpRight, BrainCircuit, MapPin, Mail, Phone } from "@lucide/astro";
import { brand, contactDetails, navigation } from "@/data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="brand-lockup footer-lockup" href="/" aria-label={`${brand.name}, ir al inicio`}>
        <span class="brand-mark" aria-hidden="true"><BrainCircuit size={21} stroke-width={1.8} /></span>
        <span class="brand-name">{brand.name}<small>Consultoría práctica en IA</small></span>
      </a>
      <p>{brand.descriptor}. Estrategia clara y acompañamiento cercano para negocios de Guayaquil.</p>
      <p class="fictional-note">{contactDetails.note}</p>
    </div>
    <div class="footer-column">
      <h2>Explora</h2>
      {navigation.slice(1, 5).map((item) => <a href={item.href}>{item.label}</a>)}
    </div>
    <div class="footer-column footer-contact">
      <h2>Conversemos</h2>
      <a href={`mailto:${contactDetails.email}`}><Mail size={16} aria-hidden="true" />{contactDetails.email}</a>
      <a href={`tel:${contactDetails.phone.replaceAll(" ", "")}`}><Phone size={16} aria-hidden="true" />{contactDetails.phone}</a>
      <span><MapPin size={16} aria-hidden="true" />{contactDetails.location}</span>
      <a class="footer-contact-link" href="/contacto">Agenda una conversación <ArrowUpRight size={15} aria-hidden="true" /></a>
    </div>
  </div>
  <div class="footer-bottom">
    <div class="container footer-bottom-inner">
      <span>© {year} {brand.name}</span>
      <span>Hecho con criterio, en Guayaquil.</span>
    </div>
  </div>
</footer>
