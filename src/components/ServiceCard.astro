---
import { ArrowRight, ScanSearch, Target, Workflow, MessageCircle, BookOpen } from "@lucide/astro";
import type { Service, ServiceIcon } from "@/data/services";

interface Props {
  service: Service;
  index?: number;
}

const { service, index } = Astro.props;
const serviceIcons: Record<ServiceIcon, typeof ScanSearch> = {
  scan: ScanSearch,
  target: Target,
  workflow: Workflow,
  messages: MessageCircle,
  book: BookOpen,
};
const Icon = serviceIcons[service.icon];
---

<article class="service-card">
  <div class="card-topline"><span class="service-icon"><Icon size={21} stroke-width={1.7} aria-hidden="true" /></span><span class="card-index">{String((index ?? 0) + 1).padStart(2, "0")}</span></div>
  <h3>{service.title}</h3>
  <p>{service.summary}</p>
  <a class="text-link" href="/contacto">Conversemos <ArrowRight size={15} aria-hidden="true" /></a>
</article>
